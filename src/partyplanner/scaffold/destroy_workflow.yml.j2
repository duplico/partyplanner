# workflow_dispatch only — never wire destroy to config deletion. Exports a
# final RSVP snapshot artifact before tearing the capsule down.
name: destroy-{{ name }}
on: workflow_dispatch

permissions:
  contents: read
  id-token: write

jobs:
  destroy:
    uses: duplico/partyplanner/.github/workflows/destroy-occasion.yml@{{ ref }}
    with:
      occasion_dir: occasions/{{ name }}
      role_to_assume: {{ role_arn }}
      tf_state_bucket: {{ state_bucket }}
      partyplanner_ref: {{ ref }}
      aws_region: {{ region }}
