{% extends "base.html.j2" %}
{% block content %}
<header>
  {% if occasion_photo %}<img class="hero" src="{{ occasion_photo }}" alt="">{% endif %}
  <h1>{{ occasion.title }}</h1>
  {% if occasion.blurb %}<p class="blurb">{{ occasion.blurb }}</p>{% endif %}
</header>
{% for event in events %}
<section class="event" id="{{ event.id }}">
  {% if event.photo %}<img class="event-photo" src="{{ event.photo }}" alt="">{% endif %}
  <h2>{{ event.title }}</h2>
  {% if event.when %}
  <p class="when">
    {{ event.when }}
    {% if event.ics %} · <a href="{{ event.ics }}" download>add to calendar</a>{% endif %}
  </p>
  {% endif %}
  {% if event.where %}<p class="where">{{ event.where }}</p>{% endif %}
  {% if event.blurb %}<p class="event-blurb">{{ event.blurb }}</p>{% endif %}
  {% if event.rsvp_open %}
  <div class="rsvp" data-event-id="{{ event.id }}">
    <h3>Who's coming <span class="counts" data-counts="{{ event.id }}"></span></h3>
    <ul class="rsvp-list" data-rsvps="{{ event.id }}"><li class="muted">Loading…</li></ul>
    <form class="rsvp-form" data-form="{{ event.id }}">
      <input type="text" name="name" placeholder="Your first name" maxlength="40" required>
      <select name="response" aria-label="Response">
        <option value="yes">Yes</option>
        <option value="maybe">Maybe</option>
        <option value="no">No</option>
      </select>
      <label class="plus">+<input type="number" name="party_size" value="0" min="0" max="10"></label>
      <button type="submit">RSVP</button>
    </form>
    <p class="form-status" data-status="{{ event.id }}" role="status" aria-live="polite"></p>
  </div>
  {% endif %}
</section>
{% endfor %}
{% endblock %}
{% block scripts %}
<script src="/assets/app.js"></script>
{% endblock %}
